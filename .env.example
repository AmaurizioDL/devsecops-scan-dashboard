# Copia este archivo como referencia de las variables de entorno que necesita
# el backend. Spring Boot las lee vía ${DB_USERNAME}/${DB_PASSWORD} en
# application.properties (con fallback a valores por defecto de dev).
#
# No se leen automáticamente desde un archivo .env: expórtalas en tu shell
# antes de correr la app, o defínelas como variables de entorno en tu
# configuración de ejecución de IntelliJ.

DB_USERNAME=postgres
DB_PASSWORD=changeme
