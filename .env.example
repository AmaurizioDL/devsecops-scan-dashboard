# Copia este archivo como .env (gitignored) en la raiz del proyecto.
#
# docker compose SI lee automaticamente un archivo .env en la raiz para
# sustituir estas variables en docker-compose.yml. Todos los servicios
# (postgres, backend, grafana) las leen desde ahi -- no hace falta
# exportarlas a mano ni configurarlas en el IDE si corres todo con
# `docker compose up`.
#
# Si en cambio corres el backend fuera de Docker (mvn spring-boot:run /
# IntelliJ) contra el Postgres dockerizado, exporta estas mismas variables
# en tu shell o en la Run Configuration -- Spring Boot no lee .env solo.

DB_USERNAME=postgres
DB_PASSWORD=changeme

# Password del usuario "admin" de la UI web de Grafana (no tiene relacion
# con Postgres). Si no se define, usa "admin" por defecto.
GRAFANA_ADMIN_PASSWORD=admin
