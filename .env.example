# Copia este archivo como .env (gitignored) en la raíz del proyecto.
#
# docker compose SÍ lee automáticamente un archivo .env en la raíz para
# sustituir ${DB_PASSWORD} / ${GRAFANA_ADMIN_PASSWORD} en docker-compose.yml
# (usado por el servicio grafana para conectarse a Postgres).
#
# Spring Boot NO lee .env automáticamente: además de crear este archivo,
# exporta DB_USERNAME/DB_PASSWORD en tu shell antes de correr el backend
# (o defínelas como variables de entorno en tu configuración de ejecución
# de IntelliJ).

DB_USERNAME=postgres
DB_PASSWORD=changeme

# Password del usuario "admin" de la UI web de Grafana (no tiene relación
# con Postgres). Si no se define, usa "admin" por defecto.
GRAFANA_ADMIN_PASSWORD=admin
